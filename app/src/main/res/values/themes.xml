<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Default accent: Indigo. The Theme.PDFsmith.* overlays below re-tint the
         whole app (toolbars, headers, icons) by overriding colorPrimary. -->
    <style name="Theme.PDFsmith" parent="Theme.Material3Expressive.DayNight.NoActionBar">
        <item name="colorPrimary">#FF3B5BDB</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">#FFDDE4FF</item>
        <item name="colorOnPrimaryContainer">#FF16224F</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container</item>
        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowAnimationStyle">@style/Animation.PDFsmith</item>
        <item name="textInputStyle">@style/Widget.KavoPDF.TextInput</item>
        <!-- Material 3 Expressive: a larger, softer shape scale, and pill buttons -->
        <item name="shapeAppearanceCornerExtraSmall">6dp</item>
        <item name="shapeAppearanceCornerSmall">10dp</item>
        <item name="shapeAppearanceCornerMedium">16dp</item>
        <item name="shapeAppearanceCornerLarge">22dp</item>
        <item name="shapeAppearanceCornerExtraLarge">30dp</item>
        <item name="materialButtonStyle">@style/Widget.KavoPDF.Button</item>
        <item name="alertDialogTheme">@style/ThemeOverlay.KavoPDF.Dialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.KavoPDF.Dialog</item>
    </style>

    <style name="Theme.PDFsmith.Teal">
        <item name="colorPrimary">#FF0C8599</item>
        <item name="colorPrimaryContainer">#FFD3F1F5</item>
        <item name="colorOnPrimaryContainer">#FF0B3038</item>
    </style>

    <style name="Theme.PDFsmith.Violet">
        <item name="colorPrimary">#FF7048E8</item>
        <item name="colorPrimaryContainer">#FFE5DBFF</item>
        <item name="colorOnPrimaryContainer">#FF221454</item>
    </style>

    <style name="Theme.PDFsmith.Green">
        <item name="colorPrimary">#FF2F9E44</item>
        <item name="colorPrimaryContainer">#FFD3F9D8</item>
        <item name="colorOnPrimaryContainer">#FF0B2E13</item>
    </style>

    <style name="Theme.PDFsmith.Crimson">
        <item name="colorPrimary">#FFC2255C</item>
        <item name="colorPrimaryContainer">#FFFCE0E9</item>
        <item name="colorOnPrimaryContainer">#FF4A0E24</item>
    </style>

    <!-- Light, quick activity transitions -->
    <style name="Animation.PDFsmith" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out_slight</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in_slight</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>

    <style name="TextAppearance.PDFsmith.SectionHeader" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
    </style>

    <!-- Every dialog gets the same soft, rounded surface. In the theme so a new
         dialog can never come out square by accident. -->
    <style name="ShapeAppearance.KavoPDF.Dialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">26dp</item>
    </style>

    <style name="ThemeOverlay.KavoPDF.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.KavoPDF.Dialog</item>
        <item name="android:windowBackground">@drawable/bg_dialog_rounded</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>
    <!-- For screens that open a picker straight away: nothing to animate, so the
         screen and the picker never animate over each other. -->
    <style name="Animation.KavoPDF.None" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/instant</item>
        <item name="android:activityOpenExitAnimation">@anim/instant</item>
        <item name="android:activityCloseEnterAnimation">@anim/instant</item>
        <item name="android:activityCloseExitAnimation">@anim/instant</item>
    </style>
    <!-- Input fields are pills everywhere. Set as the theme's textInputStyle so a
         field can never come out as a bare underline by accident. -->
    <style name="Widget.KavoPDF.TextInput" parent="Widget.Material3.TextInputLayout.FilledBox">
        <item name="boxBackgroundColor">@color/field_bg</item>
        <item name="boxCornerRadiusTopStart">26dp</item>
        <item name="boxCornerRadiusTopEnd">26dp</item>
        <item name="boxCornerRadiusBottomStart">26dp</item>
        <item name="boxCornerRadiusBottomEnd">26dp</item>
        <item name="boxStrokeWidth">0dp</item>
        <item name="boxStrokeWidthFocused">0dp</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
    </style>
    <!-- Matches the launcher mark: the amber of the K on a near-black ground. -->
    <style name="Theme.PDFsmith.Amber">
        <item name="colorPrimary">#FFF5A524</item>
        <item name="colorOnPrimary">#FF241A00</item>
        <item name="colorPrimaryContainer">#FFFFE7C2</item>
        <item name="colorOnPrimaryContainer">#FF3D2A00</item>
        <item name="colorSecondary">#FFB26A00</item>
        <item name="colorSecondaryContainer">#FFFFDFAE</item>
        <item name="android:statusBarColor">#FF241A00</item>
    </style>
    <style name="ShapeAppearance.KavoPDF.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="Widget.KavoPDF.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/ShapeAppearance.KavoPDF.Pill</item>
    </style>
</resources>
