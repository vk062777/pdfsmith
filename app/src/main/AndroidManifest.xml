<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".PdfSmithApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PDFsmith">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ViewerActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
            </intent-filter>
        </activity>

        <activity android:name=".PagesActivity" android:exported="false" android:label="@string/tool_pages" />
        <activity android:name=".MergeActivity" android:exported="false" android:label="@string/tool_merge" />
        <activity android:name=".ImagesToPdfActivity" android:exported="false" android:label="@string/tool_images_pdf" />
        <activity android:name=".AnnotateActivity" android:exported="false" android:label="@string/tool_annotate" />
        <activity android:name=".FormsActivity" android:exported="false" android:label="@string/tool_forms" />
        <activity android:name=".ToolsActivity" android:exported="false" />
        <activity
            android:name=".CreatePdfActivity"
            android:exported="false"
            android:label="@string/tool_create_pdf"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
